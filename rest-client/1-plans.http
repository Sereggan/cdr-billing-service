### List all subscription plans
# Seeded by Flyway: STANDARD and PREMIUM.
GET {{host}}/v1/plans
Accept: application/json

> {%
    client.test("Both seeded plans are returned", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.length === 2, "Expected 2 plans, got " + response.body.length);
    });
    client.test("Rates are serialized as numbers, not strings", function () {
        client.assert(typeof response.body[0].callRate === "number", "callRate must be numeric");
    });
%}
